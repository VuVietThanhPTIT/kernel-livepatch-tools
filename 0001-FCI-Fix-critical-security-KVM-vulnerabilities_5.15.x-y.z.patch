 static void mmu_spte_set(u64 *sptep, u64 spte);
 static union kvm_mmu_page_role
 kvm_mmu_calc_root_page_role(struct kvm_vcpu *vcpu);
-
+static noinline bool is_page_fault_root_stale(struct kvm_vcpu *vcpu);
 struct kvm_mmu_role_regs {
 	const unsigned long cr0;
 	const unsigned long cr4;
@@ -3009,7 +3009,7 @@ static int __direct_map(struct kvm_vcpu *vcpu, gpa_t gpa, u32 error_code,
 		if (it.level == level)
 			break;
 
-		drop_large_spte(vcpu, it.sptep);
+		drop_large_spte(vcpu, it.sptep); kvm_mmu_zap_child_spte_if_mismatch(vcpu, it.sptep, NULL, NULL, base_gfn, it.level, true, ACC_ALL);
 		if (is_shadow_present_pte(*it.sptep))
 			continue;
 
@@ -4017,7 +4017,7 @@ static int direct_page_fault(struct kvm_vcpu *vcpu, gpa_t gpa, u32 error_code,
 				    pfn, prefault);
 	} else {
 		r = make_mmu_pages_available(vcpu);
-		if (r)
+		if (r || is_page_fault_root_stale(vcpu))
 			goto out_unlock;
 		r = __direct_map(vcpu, gpa, error_code, map_writable, max_level, pfn,
 				 prefault, is_tdp);
@@ -6323,3 +6323,57 @@ void kvm_mmu_pre_destroy_vm(struct kvm *kvm)
 	if (kvm->arch.nx_lpage_recovery_thread)
 		kthread_stop(kvm->arch.nx_lpage_recovery_thread);
 }
+
+static noinline void kvm_mmu_zap_child_spte_if_mismatch(struct kvm_vcpu *vcpu,
+									 u64 *sptep, const gfn_t *table_gfn,
+									 const unsigned int *pt_access, gfn_t gfn,
+									 unsigned int parent_level,
+									 int direct, unsigned int access)
+{
+	union kvm_mmu_page_role role;
+	struct kvm_mmu_page *parent_sp;
+	struct kvm_mmu_page *child;
+	bool has_4_byte_gpte;
+	unsigned int index;
+	LIST_HEAD(invalid_list);
+
+	if (!is_shadow_present_pte(*sptep) || is_large_pte(*sptep))
+		return;
+
+	if (!direct && table_gfn) {
+		index = parent_level - 2;
+		gfn = table_gfn[index];
+		access = pt_access[index];
+	}
+
+	parent_sp = sptep_to_sp(sptep);
+	child = to_shadow_page(*sptep & PT64_BASE_ADDR_MASK);
+
+	has_4_byte_gpte = !parent_sp->role.gpte_is_8_bytes;
+	role = parent_sp->role;
+	role.level = parent_level - 1;
+	role.direct = direct;
+	if (role.direct)
+		role.gpte_is_8_bytes = true;
+	role.access = access;
+	if (has_4_byte_gpte && role.level == PG_LEVEL_4K)
+		role.quadrant = ((unsigned long)(sptep - parent_sp->spt)) & 1;
+
+	if (child && child->gfn == gfn && child->role.word == role.word)
+		return;
+
+	mmu_page_zap_pte(vcpu->kvm, parent_sp, sptep, &invalid_list);
+	kvm_mmu_remote_flush_or_zap(vcpu->kvm, &invalid_list, true);
+}
+
+static noinline bool is_page_fault_root_stale(struct kvm_vcpu *vcpu)
+{
+	struct kvm_mmu_page *sp;
+
+	sp = to_shadow_page(vcpu->arch.mmu->root_hpa);
+	if (sp)
+		return sp->role.invalid ||
+		       unlikely(sp->mmu_valid_gen != vcpu->kvm->arch.mmu_valid_gen);
+
+	return kvm_test_request(KVM_REQ_MMU_RELOAD, vcpu);
+}
